{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ruff check (workspace)",
            "type": "shell",
            "command": "ruff check --output-format=concise .",
            "problemMatcher": {
                "owner": "ruff",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+): (\\S+) (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "code": 4,
                    "message": 5
                }
            }
        }
    ]
}
